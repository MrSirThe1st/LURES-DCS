# Copy to .env.local / app env files. Never commit real secrets.

# Supabase (public / client-safe — never put the service-role key here)
VITE_SUPABASE_URL={{AUTH_PROJECT_URL}}
VITE_SUPABASE_ANON_KEY={{AUTH_ANON_KEY}}
EXPO_PUBLIC_SUPABASE_URL={{AUTH_PROJECT_URL}}
EXPO_PUBLIC_SUPABASE_ANON_KEY={{AUTH_ANON_KEY}}

# Supabase (privileged — never expose to the desktop UI bundle or mobile app)
SUPABASE_SERVICE_ROLE_KEY={{AUTH_SERVICE_ROLE_KEY}}

# Database (tooling / migrations — no credentials in git)
DATABASE_URL={{DATABASE_URL}}
DIRECT_URL={{DIRECT_URL}}
